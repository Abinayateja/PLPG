export const roadmaps: Record<string, GoalRoadmap> = {
  "AI Engineer": aiEngineerRoadmap,
  "Data Scientist": dataScientistRoadmap,
  "Web Developer": webDeveloperRoadmap,
};

// Year-based filtering: early years focus on phases 1-2, later years on 3-4
export function getFilteredRoadmap(
  goal: string,
  year?: string,
  level?: string
): GoalRoadmap {
  const roadmap = roadmaps[goal] || aiEngineerRoadmap;

  // If no year info, return full roadmap
  if (!year) return roadmap;

  const yearNum = parseInt(year);

  // Highlight recommended phases based on year
  // 1st year: focus phases 1-2
  // 2nd year: phases 1-3
  // 3rd year: phases 2-4
  // 4th year: phases 3-4
  return {
    ...roadmap,
    phases: roadmap.phases.map((phase) => {
      let recommended = true;
      if (yearNum <= 2 && phase.id > yearNum + 1) recommended = false;
      if (yearNum >= 3 && phase.id < yearNum - 1) recommended = false;
      return { ...phase, _recommended: recommended } as RoadmapPhase & { _recommended?: boolean };
    }),
  };
}

export function getSkillStatus(
  skillId: string,
  userSkills: string[],
  diagnosticLevel?: string
): "completed" | "current" | "locked" | "available" {
  const normalizedSkills = userSkills.map((s) => s.toLowerCase());
  const normalizedId = skillId.toLowerCase().replace(/-/g, " ");

  if (normalizedSkills.includes(normalizedId) || normalizedSkills.includes(skillId)) {
    return "completed";
  }

  return "available";
}
